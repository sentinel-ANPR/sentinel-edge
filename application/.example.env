NODE_ID=CALICUT
LOCATION=CLT
CENTRAL_API_URL=http://0.0.0.0:8000
# Add the streams you want to process, separated by commas
RTSP_STREAM=in1.mp4,in2.mp4
REDIS_HOST=localhost
REDIS_PORT=6379
DEV_MODE=0
VISUAL_MODE=1

# Monitor length
MONITOR_INTERVAL_SECONDS = 15

# System autoscaling guardrails
MAX_CPU_PERCENT=85
MAX_RAM_PERCENT=85

# OCR worker scaling
OCR_MIN_WORKERS=1
OCR_MAX_WORKERS=2
OCR_SCALE_THRESHOLD=20

# Color worker scaling
COLOR_MIN_WORKERS=1
COLOR_MAX_WORKERS=2
COLOR_SCALE_THRESHOLD=20

# Logo worker scaling
LOGO_MIN_WORKERS=1
LOGO_MAX_WORKERS=2
LOGO_SCALE_THRESHOLD=20

# Violation worker scaling
VIOLATION_MIN_WORKERS=1
VIOLATION_MAX_WORKERS=2
VIOLATION_SCALE_THRESHOLD=15

# Model paths (relative to application/ or absolute)
MODEL_VEHICLE_CLASSIFIER_PATH=models/classifier-yolov8n.pt
MODEL_PLATE_DETECTOR_PATH=models/license_plate_detector.pt
MODEL_COLOR_PATH=models/colour-yolo.pt
MODEL_SVM_PATH=models/color/svm_model.pkl
MODEL_SCALER_PATH = models/color/scaler.pkl
MODEL_ENCODER_PATH = models/color/encoder.pkl
MODEL_LOGO_PATH=models/logo-detector-yolo.pt
MODEL_VIOLATION_PATH=models/violations_yolo11n.pt